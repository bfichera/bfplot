{
  "name": "@bfplot/viewer",
  "version": "0.9.9",
  "description": "Dependency-light interactive browser viewer for BFPlot artifacts",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "computer-modern": "^0.1.3",
    "fzstd": "^0.1.1",
    "temml": "^0.14.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
